{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Span"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Level:u3}] {Message:lj}{NewLine}{Exception}{NewLine}{NewLine}",
          "restrictedToMinimumLevel": "Debug"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\Users\\avery\\Repositories\\TollCents-Web\\TollCents.ConsolePlayground\\logs\\log.txt",
          "restrictedToMinimumLevel": "Debug" // set to "Fatal" to effectively disable.
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Integrations": {
    "GoogleMaps": {
      "ApiKey": "",
      "UseMockServices": false
    },
    "TEXpress": {
      "MetadataFilePath": "C:\\Users\\Avery\\source\\repos\\TollCents\\Data\\texpress-segments.json",
      "TollAccessPointMatchToleranceMiles": 0.01,
      "NoTollTagPriceMultiplier": 2,
      "AnalysisModeEnabled": true
    }
